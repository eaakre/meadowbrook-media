# Sanity project settings — get these from sanity.io/manage
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production

# Only needed for server-side authenticated requests (drafts, mutations)
SANITY_API_READ_TOKEN=

# Used for sitemap.xml/robots.txt absolute URLs — set to the production domain
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Contact form (see src/app/api/contact/route.ts) — get an API key at resend.com
RESEND_API_KEY=
CONTACT_FORM_TO_EMAIL=
